     ]
    }
   ],
   "source": [
    "s = input(\"Enter the string:\")\n",
    "rev = []\n",
    "\n",
    "for i in range(len(s)-1, -1, -1):\n",
    "    rev.append(s[i])\n",
    "\n",
    "rev_str = \"\".join(rev)\n",
    "\n",
    "if s == rev_str:\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not Palindrome\")"
