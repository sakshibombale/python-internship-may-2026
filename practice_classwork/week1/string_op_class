    "def reverse_words():\n",
    "    sentence = input(\"Enter a sentence: \")\n",
    "\n",
    "    words = []\n",
    "\n",
    "    for word in sentence.split():\n",
    "        words.append(word)\n",
    "\n",
    "    reversed_words = words[::-1]\n",
    "\n",
    "    result = \" \".join(reversed_words)\n",
    "\n",
    "    print(\"Reversed sentence:\", result)\n",
    "\n",
    "reverse_words()"
