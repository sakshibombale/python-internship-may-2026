    "str = input(\"Enter the string:\")\n",
    "\n",
    "vowels = {'a':0, 'e':0, 'i':0, 'o':0, 'u':0}\n",
    "total = 0\n",
    "\n",
    "for ch in str.lower():\n",
    "    if ch in vowels:\n",
    "        vowels[ch] += 1\n",
    "        total += 1\n",
    "\n",
    "print(\"Total vowels =\", total)\n",
    "print(\"Vowel counts =\", vowels)"
