   "source": [
    "# Q9). Keep accepting numbers from the user until they enter 0. Then print the total count of numbers entered,\n",
    "# their sum, and their average. Do not include 0 in the calculations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "e9015c29-c69b-4513-af87-5aa2cb147ed9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number (0 to stop):  3\n",
      "Enter a number (0 to stop):  4\n",
      "Enter a number (0 to stop):  5\n",
      "Enter a number (0 to stop):  6\n",
      "Enter a number (0 to stop):  8\n",
      "Enter a number (0 to stop):  8\n",
      "Enter a number (0 to stop):  0\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Count = 6\n",
      "Sum = 34\n",
      "Average = 5.666666666666667\n"
     ]
    }
   ],
   "source": [
    "count = 0\n",
    "total = 0\n",
    "\n",
    "while True:\n",
    "    num = int(input(\"Enter a number (0 to stop): \"))\n",
    "\n",
    "    if num == 0:\n",
    "        break\n",
    "\n",
    "    count += 1\n",
    "    total += num\n",
    "\n",
    "if count > 0:\n",
    "    average = total / count\n",
    "    print(\"Count =\", count)\n",
    "    print(\"Sum =\", total)\n",
    "    print(\"Average =\", average)\n",
    "else:\n",
    "    print(\"No numbers entered\")"
   ]
  },
