    "# Q10). Take n as input and print a triangle pattern of n rows made of asterisks, where row i has (2i - 1) stars centered appropriately."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "8078b652-dde9-4f79-a804-733944bc140d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter number of rows:  4\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   *\n",
      "  ***\n",
      " *****\n",
      "*******\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter number of rows: \"))\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    spaces = n - i\n",
    "    stars = 2 * i - 1\n",
    "\n",
    "    print(\" \" * spaces + \"*\" * stars)"
   ]
