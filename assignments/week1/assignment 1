    "# Q8). Take a positive integer n as input and print all prime numbers from 2 to n."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "18944fce-ec26-4236-a5a8-2dd37d88b4fb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  6\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2\n",
      "3\n",
      "5\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "for num in range(2, n + 1):\n",
    "    prime = True\n",
    "\n",
    "    for i in range(2, num):\n",
    "        if num % i == 0:\n",
    "            prime = False\n",
    "            break\n",
    "\n",
    "    if prime:\n",
    "        print(num)"
   ]
